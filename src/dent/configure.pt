from    dent.configure  import *
import  pytest

def test_parseargs_config():
    enter = action(['-B', 'debian:12', '-s', 'foo', 'mycont', 'echo', 'hi'])
    assert isinstance(enter, Enter)
    config = enter.config
    assert isinstance(config.image_source, BuildImage)
    assert ('debian:12', 'mycont', ['echo', 'hi'], ['foo'], False) \
        == (config.image_source.base_image, config.CONTAINER_NAME,
            config.COMMAND, config.share_ro, config.quiet)

def test_parseargs_default_command():
    enter = action(['mycont'])
    assert isinstance(enter, Enter)
    assert ['bash', '-l'] == enter.config.COMMAND

def test_parseargs_bad():
    cname = 'my-container-name'
    def bad_args():  return pytest.raises(SystemExit)

    #   Command line options that must not have a container name.
    with bad_args():  action(['--version', cname])
    with bad_args():  action(['--list-base-images', cname])
    with bad_args():  action(['-P', 'dockerfile', cname])
    with bad_args():  action(['--version', '-L'])

#   -B and -i are alternative ways of specifying the image for a new
#   container, and -R and -t configure only the image built from -B.
#   XXX The -B/-i exclusion is done by argparse, which will not be parsing
#   config files; it will have to be restated as a check on the merged
#   Config, as the -R and -t checks already are.
@pytest.mark.parametrize('_id, ok, opts', [
    ('base',        True,   ['-B', 'deb']),
    ('image',       True,   ['-i', 'img']),
    ('neither',     True,   []),
    ('base+tag',    True,   ['-B', 'deb', '-t', 'tg']),
    ('base+rebuild',True,   ['-B', 'deb', '-R']),
    ('base+image',  False,  ['-B', 'deb', '-i', 'img']),
    ('tag alone',   False,  ['-t', 'tg']),
    ('rebuild alone',False, ['-R']),
    ('image+tag',   False,  ['-i', 'img', '-t', 'tg']),
    ('image+rebuild',False, ['-i', 'img', '-R']),
])
def test_action_image_opts(_id, ok, opts):
    argv = opts + ['mycont']
    if ok:
        assert isinstance(action(argv), Enter)
    else:
        with pytest.raises(SystemExit):  action(argv)

def test_action_version():
    assert PrintVersion() == action(['--version'])

def test_action_list_base_images():
    assert ListBaseImages() == action(['-L'])

def test_action_print_file():
    assert PrintFile('dockerfile', 'debian:12') \
        == action(['-P', 'dockerfile', '-B', 'debian:12'])
    assert PrintFile('setup-pkg', None) == action(['-P', 'setup-pkg'])
