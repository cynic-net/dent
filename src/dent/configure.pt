from    dent.configure  import *
from    pathlib  import Path
import  json, pytest

####################################################################
#   Specific Options Tests

@pytest.mark.parametrize('cls, fieldnames', [
    (BuildImage, ('base_image', 'tag', 'tmpdir', 'keep_tmpdir', 'force_rebuild', 'progress', )),
    (UseImage,   ('image', )),
    (RunConfig,  ('run_opt', 'set_env', 'share_ro', 'share_rw', )),
])
def test_dataclass_fieldnames(cls, fieldnames):
    assert fieldnames == dataclass_fieldnames(cls)

def test_parseargs_config():
    enter = action(['-B', 'debian:12', '-s', 'foo', 'mycont', 'echo', 'hi'])
    assert isinstance(enter, Enter)
    config = enter.config
    assert isinstance(config.image_source, BuildImage)
    assert ('debian:12', 'mycont', ['echo', 'hi'], ['foo'], False) \
        == (config.image_source.base_image, config.CONTAINER_NAME,
            config.COMMAND, config.run_config.share_ro, config.quiet)

def test_action_version():
    assert PrintVersion() == action(['--version'])

def test_action_list_base_images():
    assert ListBaseImages() == action(['-L'])

def test_action_print_file():
    assert PrintFile('dockerfile', 'debian:12') \
        == action(['-P', 'dockerfile', '-B', 'debian:12'])
    assert PrintFile('setup-pkg', None) == action(['-P', 'setup-pkg'])

def test_parseargs_set_env():
    enter = action(['--set-env=FOO=bar', '--set-env=BAZ=', 'mycont'])
    assert isinstance(enter, Enter)
    assert { 'FOO':'bar', 'BAZ':'' } == enter.config.run_config.set_env
    with pytest.raises(SystemExit):
        action(['--set-env=NO_EQUALS_SIGN', 'mycont'])

def test_parseargs_default_command():
    enter = action(['mycont'])
    assert isinstance(enter, Enter)
    assert ['bash', '-l'] == enter.config.COMMAND

####################################################################
#   Valid and invalid combinations of arguments

def test_parseargs_bad():
    cname = 'my-container-name'
    def bad_args():  return pytest.raises(SystemExit)

    #   Command line options that must not have a container name.
    with bad_args():  action(['--version', cname])
    with bad_args():  action(['--list-base-images', cname])
    with bad_args():  action(['-P', 'dockerfile', cname])
    with bad_args():  action(['--version', '-L'])

#   -B and -i are alternative ways of specifying the image for a new
#   container, and -R and -t configure only the image built from -B.
#   XXX The -B/-i exclusion is done by argparse, which will not be parsing
#   config files; it will have to be restated as a check on the merged
#   Config, as the -R and -t checks already are.
@pytest.mark.parametrize('_id, ok, opts', [
    ('base',        True,   ['-B', 'deb']),
    ('image',       True,   ['-i', 'img']),
    ('neither',     True,   []),
    ('base+tag',    True,   ['-B', 'deb', '-t', 'tg']),
    ('base+rebuild',True,   ['-B', 'deb', '-R']),
    ('base+image',  False,  ['-B', 'deb', '-i', 'img']),
    ('tag alone',   True,  ['-t', 'tg']),
    ('rebuild alone',True, ['-R']),
    ('image+tag',   False,  ['-i', 'img', '-t', 'tg']),
    ('image+rebuild',False, ['-i', 'img', '-R']),
])
def test_action_image_opts(_id, ok, opts):
    argv = opts + ['mycont']
    if ok:
        assert isinstance(action(argv), Enter)
    else:
        with pytest.raises(SystemExit):  action(argv)

####################################################################
#   dent_share

SHARE = f'{environ.get("HOME")}/.local/state/dent/Xcname'

def test_dent_share():
    p = Config.testconfig().dent_share()
    assert str(p) == SHARE

def ishare(src, dst, ty='bind'):
    ' A Mounts entry as found in `docker inspect` container output. '
    return { 'Type':ty, 'Source':src, 'Destination':dst, 'RW':True }

@pytest.mark.parametrize('_id, expected, inspect', [
    ('no-mounts-key',   False, {}),
    ('null-mounts',     False, { 'Mounts': None }),
    ('empty-mounts',    False, { 'Mounts': [] }),
    ('other-source',    False, { 'Mounts': [ishare('/other', '/other')] }),
    #   What identifies a bind is the host-side Source; the in-container
    #   path may differ (e.g. the Dent share in older containers, which
    #   the dshare script handles itself).
    ('same-dest',       True,  { 'Mounts': [ishare(SHARE, SHARE)] }),
    ('old-dest',        True,  { 'Mounts': [ishare(SHARE, '/old/path')] }),
    #   A foreign mount at the sought path's usual destination is no bind.
    ('foreign-at-dest', False, { 'Mounts': [ishare('/foreign', SHARE)] }),
    #   Non-bind mounts don't count, whatever their Source.
    ('volume-not-bind', False, { 'Mounts': [ishare(SHARE, SHARE, 'volume')] }),
])
def test_has_dent_share_unit(_id, expected, inspect):
    conf = Config.testconfig()
    assert expected is conf.has_dent_share(inspect)

@pytest.mark.parametrize('expected, path', [
    (True,  '/home/alice/.local/state/dent/deb13'),
    (False, '/home/alice/OLD/dent/deb13'),
    (False, '/home/alice/notbind'),
])
def test_has_dent_share_realdata(expected, path):
    ' Tests with actual `docker container inspect` output. '
    conf = Config.testconfig()
    conf.dent_share = lambda: path 	# type: ignore
    assert expected \
        is conf.has_dent_share(DOCKER_CONTAINER_INSPECT_FULL)

####################################################################
#   Config comparison against existing containers

def test_share_paths():
    home = Path.home()
    rc = RunConfig(share_ro=['/etc/foo', 'rel'], share_rw=['/home/bar'])
    assert [    (Path('/etc/foo'), False),
                (home/'rel',       False),
                (Path('/home/bar'), True),
           ] == rc.share_paths()

def mount(p, rw):
    ' A Mounts entry as found in `docker inspect` container output. '
    return { 'Type':'bind', 'Source':str(p), 'Destination':str(p), 'RW':rw }

#   The Dent share path passed to the comparison methods in these tests.
DSHARE = Path('/home/x/.local/state/dent/Xcname')

def test_mismatches_ok():
    conf = Config.testconfig(
        run_config=RunConfig(share_ro=['/ro/dir'], share_rw=['/rw/dir']))
    inspect = { 'Mounts': [
        mount('/ro/dir', False), mount('/rw/dir', True), mount(DSHARE, True),
        mount('/unrelated', True),      # extra mounts are not a mismatch
        ]}
    assert [] == conf.mismatches(inspect, DSHARE)

def test_mismatches_bad():
    conf = Config.testconfig(run_config=RunConfig(
        share_ro=['/ro/dir', '/badsrc', '/volmnt'],
        share_rw=['/rw/dir', '/absent'],
        set_env={ 'TERM':'vt100' }))
    inspect = { 'Mounts': [
        mount('/ro/dir', True),         # mounted, but rw instead of ro
        dict(mount('/badsrc', False), Source='/elsewhere'),
        dict(mount('/volmnt', False), Type='volume'),   # not a bind mount
        mount('/rw/dir', True),         # correct
        mount(DSHARE, True),
        ]}                              # /absent not mounted at all;
                                        # TERM not set at all
    ms = conf.mismatches(inspect, DSHARE)
    assert 5 == len(ms)
    assert any('/ro/dir' in m and 'read-only' in m  for m in ms)
    assert any('/badsrc' in m                       for m in ms)
    assert any('/volmnt' in m                       for m in ms)
    assert any('/absent' in m and 'read-write' in m for m in ms)
    assert any('TERM=vt100' in m                    for m in ms)

def test_mismatches_dent_share():
    #   Containers predating the share feature, and foreign containers,
    #   lack the Dent share mount; this key feature's absence is warned.
    #   Only the host-side Source and writability matter: an older
    #   container may mount the share at a different path inside, which
    #   the dent-share script knows how to handle.
    conf = Config.testconfig()
    def ms(mounts):  return conf.mismatches({'Mounts':mounts}, DSHARE)

    missing = ms([ mount('/x', True) ])
    assert 1 == len(missing)
    assert 'Dent share' in missing[0]  and str(DSHARE) in missing[0]

    assert [] == ms([ mount(DSHARE, True) ])
    assert [] == ms([ dict(mount(DSHARE, True), Destination='/old/path') ])
    assert 1 == len(ms([ mount(DSHARE, False) ]))       # ro is not enough
    assert 1 == len(ms([ dict(mount(DSHARE, True), Type='volume') ]))

def test_mismatches_no_mounts():
    #   Foreign containers may have no Mounts entry, or one that is null.
    conf = Config.testconfig(run_config=RunConfig(share_ro=['/x']))
    assert 2 == len(conf.mismatches_mounts({ 'Mounts': None }, DSHARE))
    assert 2 == len(conf.mismatches_mounts({}, DSHARE))

@pytest.mark.parametrize('_id, expected, env', [
    ('all-set',     [],             ['A=1', 'B=2', 'PATH=/bin']),
    ('wrong-value', ['B=2'],        ['A=1', 'B=other']),
    ('unset',       ['A=1'],        ['B=2']),
    ('no-env',      ['A=1', 'B=2'], None),
    #   Entries without `=` should not occur, but must not break parsing.
    ('malformed',   ['A=1', 'B=2'], ['MALFORMED']),
])
def test_mismatches_set_env_param(_id, expected, env):
    conf = Config.testconfig(run_config=RunConfig(set_env={ 'A':'1', 'B':'2' }))
    inspect = {} if env is None else { 'Config': { 'Env': env } }
    ms = conf.mismatches_set_env(inspect)
    assert len(expected) == len(ms)
    for kv in expected:  assert any(kv in m for m in ms)

def test_mismatches_set_env_none_requested():
    assert [] == Config.testconfig().mismatches_set_env({})

def test_extra_mounts():
    conf = Config.testconfig(
        run_config=RunConfig(share_ro=['/req/ro'], share_rw=['/req/rw']))
    inspect = { 'Mounts': [
        mount('/req/ro', False),                # requested: not extra
        mount('/req/rw', False),                # wrong mode, but not extra
        mount(DSHARE, True),                    # Dent share: not extra
        mount('/extra/one', True),              # extra
        mount('/extra/two', False),             # extra
        dict(mount('/vol', True), Type='volume'),       # not share-shaped
        dict(mount('/dst', True), Source='/src'),       # not share-shaped
        ]}
    ms = conf.extra_mounts(inspect, DSHARE)
    assert 2 == len(ms)
    assert any('/extra/one' in m and 'read-write' in m for m in ms)
    assert any('/extra/two' in m and 'read-only'  in m for m in ms)

def test_extra_mounts_none():
    assert [] == Config.testconfig().extra_mounts({}, DSHARE)
    assert [] == Config.testconfig().extra_mounts(
        { 'Mounts': [mount(DSHARE, True)] }, DSHARE)

