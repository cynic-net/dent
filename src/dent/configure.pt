from    dent.configure  import *
import  pytest

def test_parseargs_config():
    conf = parseargs(['-B', 'debian:12', '-s', 'foo', 'mycont', 'echo', 'hi'])
    assert isinstance(conf, Config)
    assert isinstance(conf.image_source, BuildImage)
    assert ('debian:12', 'mycont', ['echo', 'hi'], ['foo'], False) \
        == (conf.image_source.base_image, conf.CONTAINER_NAME, conf.COMMAND,
            conf.share_ro, conf.quiet)

def test_parseargs_default_command():
    conf = parseargs(['mycont'])
    assert isinstance(conf, Config)
    assert ['bash', '-l'] == conf.COMMAND

def test_parseargs_bad():
    cname = 'my-container-name'
    def bad_args():  return pytest.raises(SystemExit)

    #   Command line options that must not have a container name.
    with bad_args():  parseargs(['--version', cname])
    with bad_args():  parseargs(['--list-base-images', cname])
    with bad_args():  parseargs(['-P', 'dockerfile', cname])
    with bad_args():  parseargs(['--version', '-L'])

#   -B and -i are alternative ways of specifying the image for a new
#   container, and -R and -t configure only the image built from -B.
#   XXX The -B/-i exclusion is done by argparse, which will not be parsing
#   config files; it will have to be restated as a check on the merged
#   Config, as the -R and -t checks already are.
@pytest.mark.parametrize('_id, ok, opts', [
    ('base',        True,   ['-B', 'deb']),
    ('image',       True,   ['-i', 'img']),
    ('neither',     True,   []),
    ('base+tag',    True,   ['-B', 'deb', '-t', 'tg']),
    ('base+rebuild',True,   ['-B', 'deb', '-R']),
    ('base+image',  False,  ['-B', 'deb', '-i', 'img']),
    ('tag alone',   False,  ['-t', 'tg']),
    ('rebuild alone',False, ['-R']),
    ('image+tag',   False,  ['-i', 'img', '-t', 'tg']),
    ('image+rebuild',False, ['-i', 'img', '-R']),
])
def test_parseargs_image_opts(_id, ok, opts):
    argv = opts + ['mycont']
    if ok:
        assert isinstance(parseargs(argv), Config)
    else:
        with pytest.raises(SystemExit):  parseargs(argv)

def test_parseargs_version():
    assert PrintVersion() == parseargs(['--version'])

def test_parseargs_list_base_images():
    assert ListBaseImages() == parseargs(['-L'])

def test_parseargs_print_file():
    assert PrintFile('dockerfile', 'debian:12') \
        == parseargs(['-P', 'dockerfile', '-B', 'debian:12'])
    assert PrintFile('setup-pkg', None) == parseargs(['-P', 'setup-pkg'])
