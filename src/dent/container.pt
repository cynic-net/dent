from    dent.configure  import Config
from    dent.container  import has_bind, startup_file_text

from    datetime import datetime
from    pathlib  import Path
import  json, pytest

SHARE = '/home/x/.local/state/dent/Xcname'

def mount(src, dst, ty='bind'):
    ' A Mounts entry as found in `docker inspect` container output. '
    return { 'Type':ty, 'Source':src, 'Destination':dst, 'RW':True }

@pytest.mark.parametrize('_id, expected, inspect', [
    ('no-mounts-key',   False, {}),
    ('null-mounts',     False, { 'Mounts': None }),
    ('empty-mounts',    False, { 'Mounts': [] }),
    ('other-source',    False, { 'Mounts': [mount('/other', '/other')] }),
    #   What identifies a bind is the host-side Source; the in-container
    #   path may differ (e.g. the Dent share in older containers, which
    #   the dent-share script handles itself).
    ('same-dest',       True,  { 'Mounts': [mount(SHARE, SHARE)] }),
    ('old-dest',        True,  { 'Mounts': [mount(SHARE, '/old/path')] }),
    #   A foreign mount at the sought path's usual destination is no bind.
    ('foreign-at-dest', False, { 'Mounts': [mount('/foreign', SHARE)] }),
    #   Non-bind mounts don't count, whatever their Source.
    ('volume-not-bind', False, { 'Mounts': [mount(SHARE, SHARE, 'volume')] }),
])
def test_has_bind_unit(_id, expected, inspect):
    assert expected is has_bind(inspect, source=Path(SHARE))

@pytest.mark.parametrize('expected, path', [
    (True,  '/home/alice/.local/state/dent/deb13'),
    (False, '/home/alice/OLD/dent/deb13'),
    (False, '/home/alice/notbind'),
])
def test_has_bind_realdata(expected, path):
    ' Tests with actual `docker container inspect` output. '
    assert expected \
        is has_bind(DOCKER_CONTAINER_INSPECT_FULL, source=Path(path))

def test_startup_file_text():
    conf = Config.testconfig(env_copy=['EXISTS', 'NOT_EXISTS', 'X'])
    print(conf)
    now = datetime.now()
    env = { 'NOCOPY':'foo', 'EXISTS':'one', 'X':'''"'"'''} # NOT_EXISTS unset

    s = startup_file_text(conf, now, env) ; print(s)
    assert 'command cd' in s
    assert 'NOTEXISTS' not in s
    assert 'NOCOPY' not in s
    assert 'EXISTS=one' in s
    assert '''   X='"'"'"'"'   '''.strip() in s

